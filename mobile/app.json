{
  "expo": {
    "name": "Finanças",
    "slug": "financas-app",
    "scheme": "financas",
    "version": "1.0.0",
    "orientation": "portrait",
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4338CA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fernandesnic.financas"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7c0bb27-d90b-4316-9bca-c8689978ed9e"
      }
    },
    "owner": "fernandesnic"
  }
}
